<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Spring Boot 4.1 (Spring Framework 7) — la ligne 3.x est EOL depuis le 30/06/2026. -->
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.apontaja</groupId>
    <artifactId>apontaja-back</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>apontaja-back</name>
    <description>Apontaja — API backend (Spring Boot / Java 21)</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
             Étape 7 : starter dédié (pas flyway-core en dépendance brute) — Spring Boot 4 a
             sorti l'auto-configuration Flyway de spring-boot-autoconfigure vers un module
             dédié spring-boot-flyway, embarqué par ce starter. Sans lui, flyway-core serait
             présent sur le classpath mais l'auto-configuration ne se déclencherait jamais,
             silencieusement (piège documenté après la sortie de Boot 4.1, évité ici en amont).
             flyway-database-postgresql : support PostgreSQL, externalisé du cœur de Flyway
             depuis Flyway 10+, requis séparément.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
             Testcontainers (PostgreSQL réel), conforme à la stratégie de tests actée (§2) :
             spring-boot-testcontainers fournit l'intégration @ServiceConnection (module stable,
             non affecté par l'éclatement de spring-boot-autoconfigure — c'est un module distinct
             depuis Boot 3.1, pas une auto-configuration technique comme Flyway/JDBC).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <version>2.0.5</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>1.19.8</version>
            <scope>test</scope>
        </dependency>

        <!--
             Module cœur ArchUnit uniquement (pas archunit-junit5) : on pilote les règles avec de
             simples @TestFactory/@BeforeAll JUnit Jupiter plutôt que l'intégration annotée
             d'ArchUnit, pour ne pas dépendre d'une version précise du moteur JUnit géré par
             Spring Boot (Boot 4.1 a basculé vers JUnit Jupiter 6 sur certains projets — cf.
             les mésaventures de modularisation déjà rencontrées à l'étape 2).
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.5.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                 Config custom (back/checkstyle.xml) plutôt que google_checks.xml/sun_checks.xml
                 fournis par défaut : google_checks impose une indentation 2 espaces, en
                 contradiction directe avec .editorconfig (indent_size=4 pour *.java, déjà en
                 place depuis l'étape 1). Ruleset volontairement resserré sur des règles à faible
                 risque de faux positif (imports, doublons, style d'accolades...) plutôt que le
                 ruleset complet (pas de module Indentation, historiquement capricieux, ni de
                 Javadoc obligatoire) — objectif : un lint réellement actif dès cette étape,
                 sans provoquer une vague de violations sur le code déjà écrit et validé.
                 Lié à la phase verify : `mvn clean verify` (déjà utilisé partout, y compris en
                 CI) suffit à le déclencher, aucun changement nécessaire côté .github/workflows.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>error</violationSeverity>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
